              "raw": "{\n  \"status\": \"PAID\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/earnings/{{earningId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "earnings", "{{earningId}}", "status"] }
          }
        }
      ]
    }
  ]
}
