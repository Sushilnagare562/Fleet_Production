            },
            "url": { "raw": "{{baseUrl}}/admin/earnings", "host": ["{{baseUrl}}"], "path": ["admin", "earnings"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('earningId', String(data.id));",
                  "    console.log('Saved earningId from newly created earning');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Earnings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAuthToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/earnings", "host": ["{{baseUrl}}"], "path": ["admin", "earnings"] }
          }
        },
        {
          "name": "Mark Earning As Paid",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminAuthToken}}" },
              { "key": "Content-Type", "value": "application/json" }
